# Nigeria Tax Chatbot - Environment Variables
# Copy this file to .env and fill in your values

# --- Required for local development ---

# Hugging Face (for embeddings and model access)
HUGGINGFACE_ACCESS_TOKEN=your_huggingface_token

# Comet ML (for experiment tracking - optional)
COMET_API_KEY=your_comet_api_key

# --- Required for deployment ---

# MongoDB Database
DATABASE_HOST=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=Laws

# Qdrant Vector Database
USE_QDRANT_CLOUD=true
QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io
QDRANT_APIKEY=your_qdrant_api_key

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_ARN_ROLE=arn:aws:iam::123456789:role/SageMakerExecutionRole

# SageMaker Endpoint
HF_MODEL_ID=ocanthony4real/NigeriaTaxLlama-3.1-8B-RAG-v3
SAGEMAKER_ENDPOINT_CONFIG_INFERENCE=nigeria-tax-llama
SAGEMAKER_ENDPOINT_INFERENCE=nigeria-tax-llama
